# Configuración del servidor
PORT=4000
NODE_ENV=development

# Seguridad JWT
JWT_SECRET=super_secret_neofood_key_change_in_production
JWT_EXPIRES_IN=15m

# Seguridad Refresh Token
JWT_REFRESH_SECRET=super_secret_refresh_neofood_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos MySQL / Prisma Multi-Tenant
DATABASE_URL="mysql://root:password@localhost:3306/neofood_crm"
